# Copy to `.env` for local production-style runs.
#
# Generate:
#   SPECTRE_PATCH_API_SECRET=$(openssl rand -hex 32)
#   FREE_API_KEY=free_$(openssl rand -hex 16)
#   SOLO_API_KEY=solo_$(openssl rand -hex 16)

SPECTRE_PATCH_API_SECRET=replace-with-32-byte-hex-secret
SPECTRE_PATCH_REQUIRE_API_KEY=true
SPECTRE_PATCH_API_KEY_TIERS_JSON='{"free_replace_me":"tier_free","solo_replace_me":"tier_solo"}'

SPECTRE_PATCH_DB_PATH=data/monotile.db
SPECTRE_PATCH_STORAGE_DIR=data/jobs
SPECTRE_PATCH_ATLAS_DIR=data/atlas
SPECTRE_PATCH_REQUIRE_ATLAS=true
SPECTRE_PATCH_RUN_JOBS_IN_PROCESS=false

SPECTRE_PATCH_CORS_ALLOW_ORIGINS=https://aperiodicgenerator.com,https://www.aperiodicgenerator.com
SPECTRE_PATCH_RATE_LIMIT_POST_PATCH=30/minute
SPECTRE_PATCH_LOG_LEVEL=INFO

UVICORN_WORKERS=2
WORKER_REPLICAS=1
