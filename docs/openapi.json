                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Billing Status",
        "tags": [
          "billing"
        ]
      }
    },
    "/v1/bug-reports": {
      "post": {
        "description": "Capture a customer bug report.\n\nBody JSON: ``summary`` (required, <= 240 chars), optional ``details``\n(<= 8000 chars), ``email``, ``request_id``, ``severity``, ``page_url``,\n``user_agent``. The endpoint is intentionally unauthenticated so docs\nand dashboards can submit on a customer's behalf; auth would just slow\npeople down when they're already frustrated.",
        "operationId": "create_bug_report_v1_bug_reports_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Bug Report V1 Bug Reports Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Bug Report",
        "tags": [
          "billing"
        ]
      }
    },
