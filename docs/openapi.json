{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PatchRequest": {
        "additionalProperties": false,
        "description": "The ``POST /v1/patch`` request body.",
        "properties": {
          "force_substitution": {
            "default": false,
            "title": "Force Substitution",
            "type": "boolean"
          },
          "force_svg_large": {
            "default": false,
            "title": "Force Svg Large",
            "type": "boolean"
          },
          "formats": {
            "items": {
              "type": "string"
            },
            "title": "Formats",
            "type": "array"
          },
          "jpg_height_px": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 32000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jpg Height Px"
          },
          "jpg_quality": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 40.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jpg Quality"
          },
          "jpg_width_px": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 32000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jpg Width Px"
          },
          "mask": {
            "additionalProperties": true,
            "title": "Mask",
            "type": "object"
          },
          "palette_by_label": {
            "anyOf": [
              {
                "additionalProperties": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "type": "object"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Palette By Label"
          },
          "patch_version": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patch Version"
          },
          "png_height_px": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 32000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Png Height Px"
          },
          "png_width_px": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 32000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Png Width Px"
          },
          "rotation_deg": {
            "default": 0.0,
            "maximum": 3600.0,
            "minimum": -3600.0,
            "title": "Rotation Deg",
            "type": "number"
          },
          "scale": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "maximum": 1000000.0,
            "title": "Scale",
            "type": "number"
          },
          "seed": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "side_style": {
            "default": "flat",
            "enum": [
              "flat",
              "curvy",
              "wavy",
              "jagged",
              "blocky"
            ],
            "title": "Side Style",
            "type": "string"
          },
          "side_style_amplitude": {
            "default": 0.12,
            "maximum": 0.75,
            "minimum": 0.0,
            "title": "Side Style Amplitude",
            "type": "number"
          },
          "side_style_wavy_segments": {
            "default": 10,
            "maximum": 64.0,
            "minimum": 4.0,
            "title": "Side Style Wavy Segments",
            "type": "integer"
          },
          "stl_extrusion_mm": {
            "default": 0.0,
            "minimum": 0.0,
            "maximum": 10000.0,
            "title": "Stl Extrusion Mm",
            "type": "number"
          },
          "substitution_iterations": {
            "anyOf": [
              {
                "maximum": 12.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Substitution Iterations"
          },
          "svg_compact": {
            "default": false,
            "title": "Svg Compact",
            "type": "boolean"
          },
          "svg_deterministic_palette": {
            "default": false,
            "title": "Svg Deterministic Palette",
            "type": "boolean"
          },
          "svg_fill": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Svg Fill"
          },
          "svg_margin": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Svg Margin"
          },
          "svg_opacity": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Svg Opacity"
          },
          "svg_pixel_target": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 32000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Svg Pixel Target"
          },
          "svg_stroke": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Svg Stroke"
          },
          "svg_stroke_width": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Svg Stroke Width"
          },
          "tile_edge_ratio": {
            "default": 1.0,
            "maximum": 4.0,
            "minimum": 0.25,
            "title": "Tile Edge Ratio",
            "type": "number"
          },
          "tile_family": {
            "const": "spectre_tile_1_1",
            "default": "spectre_tile_1_1",
            "title": "Tile Family",
            "type": "string"
          },
          "tx": {
            "default": 0.0,
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "title": "Tx",
            "type": "number"
          },
          "ty": {
            "default": 0.0,
            "maximum": 1000000000.0,
            "minimum": -1000000000.0,
            "title": "Ty",
            "type": "number"
          }
        },
        "required": [
          "mask"
        ],
        "title": "PatchRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Deterministic Tier-1 API for Spectre / Tile(1,1) patches + masking + exporters. Attribution docs live in packaged `docs/ATTRIBUTION.md`.",
    "title": "Spectre Patch API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/analytics/events": {
      "post": {
        "description": "Capture first-party website launch events.\n\nThis endpoint is intentionally narrow and unauthenticated: the public\nwebsite can report low-risk interactions such as sample downloads, while\ncheckout starts, key claims, requested formats, and first successful jobs\nare recorded server-side where possible.",
        "operationId": "create_analytics_event_v1_analytics_events_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Analytics Event V1 Analytics Events Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Analytics Event",
        "tags": [
          "billing"
        ]
      }
    },
    "/v1/billing/checkout": {
      "post": {
        "description": "Start Stripe Checkout.\n\nBody JSON (optional unless defaulting): ``email``, ``plan`` \u2014 one of\n``solo_monthly``, ``solo_lifetime``, ``commercial_monthly``, or\n``commercial_lifetime``. Omitted ``plan`` defaults to ``solo_monthly``.",
        "operationId": "create_checkout_v1_billing_checkout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Checkout V1 Billing Checkout Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Checkout",
        "tags": [
          "billing"
        ]
      }
    },
    "/v1/billing/claim-key": {
      "post": {
        "operationId": "claim_checkout_key_v1_billing_claim_key_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Claim Checkout Key V1 Billing Claim Key Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Claim Checkout Key",
        "tags": [
          "billing"
        ]
      }
    },
    "/v1/billing/status": {
      "get": {
        "operationId": "billing_status_v1_billing_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Billing Status V1 Billing Status Get",
